	<parameter name="data2" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select * from venda where nome_cli like $P{nome}
and STR_TO_DATE(data_venda,'%d/%m/%Y') between $P{data1} and $P{data2} and venda.status_venda="aberta" order by data_venda]]>
	</queryString>
