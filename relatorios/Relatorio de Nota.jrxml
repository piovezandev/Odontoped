	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="mes" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="ano" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="cliente" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT venda.id_venda,venda.nome_cli,itens_venda_produto.Produto AS Nome,count(itens_venda_produto.Produto) AS Quant,produto.preco_produto AS ValorUn,sum(produto.preco_produto) AS total
from venda inner join itens_venda_produto on venda.id_venda = itens_venda_produto.id_venda inner join produto
 on produto.codigo = itens_venda_produto.id_produto
 where venda.nome_cli like $P{cliente} and  month(STR_TO_DATE( data_venda, '%d/%m/%Y')) = $P{mes} and year(STR_TO_DATE( data_venda, '%d/%m/%Y')) = $P{ano}
and venda.status_venda <> "aberta"
 Group by  itens_venda_produto.Produto]]>
	</queryString>
	<field name="id_venda" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nome_cli" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="Nome" class="java.lang.String"/>
	<field name="Quant" class="java.lang.Long"/>
	<field name="ValorUn" class="java.lang.Double"/>
	<field name="total" class="java.lang.Double"/>
	<variable name="Total" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>
	<variable name="cliente" class="java.lang.String">
		<variableExpression><![CDATA[$V{cliente}]]></variableExpression>
	</variable>
