	<queryString>
		<![CDATA[select venda.id_venda,venda.nome_cli,itens_venda_produto.produto ,itens_venda_produto.paciente,venda.data_venda ,produto.preco_produto
from  venda inner join itens_venda_produto on venda.id_venda = itens_venda_produto.id_venda inner join produto on
produto.codigo = itens_venda_produto.id_produto
 where venda.nome_cli like $P{cliente} and  month(STR_TO_DATE( data_venda, '%d/%m/%Y')) = $P{mes} and year(STR_TO_DATE( data_venda, '%d/%m/%Y')) = $P{ano}
and venda.status_venda <> "aberta" order by venda.data_venda]]>
	</queryString>
