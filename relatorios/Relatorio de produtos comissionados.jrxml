<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Relatorio Mensal por Cliente" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="369f34b0-4293-4a8e-a354-58f3f72ba022">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="nome" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="ano" class="java.lang.Integer"/>
	<parameter name="mes" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select v.id_venda,v.data_venda,p.preco_produto,v.nome_cli,ivp.produto,p.nome,p.comissionado from venda v
inner join itens_venda_produto ivp on v.id_venda = ivp.id_venda
inner join produto p on p.codigo = ivp.id_produto
where  month(STR_TO_DATE(v.data_venda, '%d/%m/%Y')) = $P{mes}
and year(STR_TO_DATE(v.data_venda, '%d/%m/%Y')) = $P{ano}
and p.comissionado ='S' and v.status_venda <> "aberta"
order by v.data_venda;]]>
	</queryString>
	<field name="id_venda" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="data_venda" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
