<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Relatorio Mensal por Cliente" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="369f34b0-4293-4a8e-a354-58f3f72ba022">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="ano" class="java.lang.Integer"/>
	<parameter name="mes" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select v.nome_cli, sum(v.valor_venda) as total, $P{ano} as ano,
case when month(STR_TO_DATE(v.data_venda, '%d/%m/%Y')) = 01 then 'Janeiro'
when month(STR_TO_DATE(v.data_venda, '%d/%m/%Y')) = 02 then 'Fevereiro'
when month(STR_TO_DATE(v.data_venda, '%d/%m/%Y')) = 03 then 'Março'
when month(STR_TO_DATE(v.data_venda, '%d/%m/%Y')) = 04 then 'Abril'
when month(STR_TO_DATE(v.data_venda, '%d/%m/%Y')) = 05 then 'Maio'
when month(STR_TO_DATE(v.data_venda, '%d/%m/%Y')) = 06 then 'Junho'
when month(STR_TO_DATE(v.data_venda, '%d/%m/%Y')) = 07 then 'Julho'
when month(STR_TO_DATE(v.data_venda, '%d/%m/%Y')) = 08 then 'Agosto'
when month(STR_TO_DATE(v.data_venda, '%d/%m/%Y')) = 09 then 'Setembro'
when month(STR_TO_DATE(v.data_venda, '%d/%m/%Y')) = 10 then 'Outubro'
when month(STR_TO_DATE(v.data_venda, '%d/%m/%Y')) = 11 then 'Novembro'
when month(STR_TO_DATE(v.data_venda, '%d/%m/%Y')) = 12 then 'Dezembro'   end as mes
from venda v where
month(STR_TO_DATE(v.data_venda, '%d/%m/%Y')) = $P{mes}
and year(STR_TO_DATE(v.data_venda, '%d/%m/%Y')) = $P{ano}
and v.status_venda <> "aberta"
group by v.nome_cli
order by v.nome_cli;]]>
	</queryString>
	<field name="nome_cli" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="total" class="java.lang.Double"/>
	<field name="ano" class="java.lang.Object"/>
	<field name="mes" class="java.lang.String"/>
	<variable name="total" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>
	<background>
		<band/>
	</background>
